#!/bin/sh
set -eu
exec 9>/run/local-services.lock
flock -x 9
if [ ! -e /run/local-services.started ]; then
    mkdir -p /run/sshd
    ssh-keygen -A
    if ! pgrep -x rsyslogd >/dev/null; then
        /usr/sbin/rsyslogd
    fi
    if ! pgrep -x sshd >/dev/null; then
        /usr/sbin/sshd -E /var/log/sshd.log
    fi
    if ! pgrep -x cron >/dev/null; then
        /usr/sbin/cron
    fi
    touch /run/local-services.started
fi
