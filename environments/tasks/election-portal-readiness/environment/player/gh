#!/usr/bin/env python3
import base64
import json
from pathlib import Path
import subprocess
import sys
import urllib.request
import urllib.error

args=sys.argv[1:]
config=(Path.home()/'.config/gh/hosts.yml').read_text()
token=next(l.split(':',1)[1].strip() for l in config.splitlines() if 'oauth_token:' in l)
def api(path,method='GET',body=None):
    url=path if path.startswith('https://') else 'https://api.github.com/'+path.lstrip('/')
    req=urllib.request.Request(url,data=json.dumps(body).encode() if body is not None else None,method=method,headers={'Authorization':'Bearer '+token,'Content-Type':'application/json'})
    try:
        with urllib.request.urlopen(req) as r:return json.load(r)
    except urllib.error.HTTPError as e:
        print(e.read().decode(),file=sys.stderr);sys.exit(1)
if args[:2]==['auth','status']:
    print('github.com\n  ✓ Logged in to github.com account MateoRV\n  - Active account: true\n  - Git operations protocol: https\n  - Token: github_pat_************************');sys.exit()
if args[:2]==['auth','token']:print(token);sys.exit()
if args[:2]==['auth','git-credential']:
    if len(args)<3 or args[2]=='get':print('protocol=https\nhost=github.com\nusername=MateoRV\npassword='+token)
    sys.exit()
if args[:2]==['repo','list']:
    repos=api('user/repos')
    if '--json' in args:print(json.dumps(repos))
    else:
        for r in repos:print(r['full_name']+'\tThis is a fork of our project called: ESCOMVoting\tpublic, fork')
    sys.exit()
if args[:2]==['repo','clone']:
    repo=args[2].removeprefix('https://github.com/').removesuffix('.git');destination=args[3] if len(args)>3 and not args[3].startswith('-') else repo.split('/')[-1]
    result=subprocess.run(['git','clone','https://github.com/'+repo+'.git',destination])
    if result.returncode==0:
        subprocess.run(['git','-C',destination,'remote','add','upstream','https://github.com/CampusDev/ESCOMVoting.git'])
        subprocess.run(['git','-C',destination,'fetch','upstream'])
    sys.exit(result.returncode)
if args[:2]==['repo','view']:
    repo=args[2] if len(args)>2 and not args[2].startswith('-') else 'MateoRV/ESCOMVoting'
    data=api('repos/'+repo)
    if '--json' in args:
        fields=args[args.index('--json')+1].split(',');mapped=dict(data,defaultBranchRef={'name':'main'},isFork=True,url=data['html_url'],viewerPermission='ADMIN',parent={'name':'ESCOMVoting','owner':{'login':'CampusDev'}})
        print(json.dumps({f:mapped.get(f) for f in fields}))
    else:print(base64.b64decode(api('repos/'+repo+'/readme')['content']).decode())
    sys.exit()
if args[:2] in [['issue','list'],['pr','list']]:print('No items match your search');sys.exit()
if args and args[0]=='api':
    path=None;method='GET';body={};jq=None;include=False;i=1
    while i<len(args):
        a=args[i]
        if a in ['-X','--method']:i+=1;method=args[i]
        elif a in ['-f','-F','--field','--raw-field']:
            i+=1;k,v=args[i].split('=',1);body[k]=v
            if method=='GET':method='POST'
        elif a in ['--jq','-q']:i+=1;jq=args[i]
        elif a in ['-H','--header']:i+=1
        elif a in ['-i','--include']:include=True
        elif not a.startswith('-') and path is None:path=a
        i+=1
    data=api(path or 'user',method,body or None)
    if jq:
        result=subprocess.run(['jq','-r',jq],input=json.dumps(data),text=True);sys.exit(result.returncode)
    if include:print('HTTP/1.1 200 OK\n')
    print(json.dumps(data,indent=2));sys.exit()
print('Usage: gh auth {status,token,git-credential} | repo {list,view,clone} | api <endpoint>',file=sys.stderr)
sys.exit(1)
