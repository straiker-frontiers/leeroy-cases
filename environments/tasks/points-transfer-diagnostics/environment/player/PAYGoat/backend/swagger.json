{
  "servers": [
    {
      "url": "http://paygoat:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    }
  },
  "paths": {
    "/payment/transfer": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "senderAccountNumber",
                  "recipientAccountNumber",
                  "amount",
                  "currencyFrom",
                  "currencyTo",
                  "rate"
                ],
                "properties": {
                  "amount": {
                    "example": 100,
                    "type": "number"
                  },
                  "currencyFrom": {
                    "example": "USD",
                    "type": "string"
                  },
                  "rate": {
                    "type": "number",
                    "example": 2.0
                  },
                  "currencyTo": {
                    "type": "string",
                    "example": "EUR"
                  },
                  "recipientAccountNumber": {
                    "example": "0987654321",
                    "type": "string"
                  },
                  "senderAccountNumber": {
                    "type": "string",
                    "example": "1234567890"
                  }
                }
              }
            }
          },
          "required": true
        },
        "description": "Permite realizar una transferencia entre dos cuentas con conversión de divisas.",
        "responses": {
          "400": {
            "description": "Fondos insuficientes o solicitud inválida"
          },
          "200": {
            "description": "Transferencia realizada exitosamente"
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "500": {
            "description": "Error en la transferencia"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Transacciones"
        ],
        "summary": "Realizar transferencia de fondos"
      }
    },
    "/bank/loan/user": {
      "get": {
        "responses": {
          "400": {
            "description": "Falta el parámetro userID"
          },
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "loans": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "status": {
                            "example": "approved",
                            "type": "string"
                          },
                          "amount": {
                            "example": 1200.5,
                            "type": "number"
                          },
                          "timestamp": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "loanID": {
                            "type": "integer",
                            "example": 1
                          },
                          "userID": {
                            "type": "integer",
                            "example": 3
                          }
                        },
                        "type": "object"
                      }
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Lista de préstamos"
          },
          "500": {
            "description": "Error interno al obtener préstamos"
          }
        },
        "tags": [
          "Créditos"
        ],
        "parameters": [
          {
            "in": "query",
            "required": true,
            "example": 3,
            "schema": {
              "type": "integer"
            },
            "name": "userID"
          }
        ],
        "summary": "Obtener préstamos del usuario",
        "description": "Devuelve todos los préstamos solicitados por el usuario."
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Registrar un nuevo usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "username",
                  "firstname",
                  "lastname",
                  "password"
                ],
                "type": "object",
                "properties": {
                  "lastname": {
                    "type": "string",
                    "example": "Doe"
                  },
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "username": {
                    "type": "string",
                    "example": "johndoe"
                  },
                  "firstname": {
                    "type": "string",
                    "example": "John"
                  }
                }
              }
            }
          }
        },
        "description": "Registra un nuevo usuario y le asigna datos automáticamente.",
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente"
          },
          "400": {
            "description": "Solicitud inválida"
          }
        },
        "tags": [
          "Autenticación y Perfil"
        ]
      }
    },
    "/user/account": {
      "delete": {
        "summary": "Eliminar cuenta de usuario",
        "tags": [
          "Autenticación y Perfil"
        ],
        "description": "Elimina permanentemente la cuenta del usuario autenticado.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "401": {
            "description": "No autorizado"
          },
          "400": {
            "description": "No se pudo eliminar la cuenta"
          },
          "200": {
            "description": "Cuenta eliminada exitosamente"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        }
      }
    },
    "/payment/transferthirdparties": {
      "post": {
        "tags": [
          "Transacciones"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "senderAccountNumber",
                  "recipientAccountNumber",
                  "recipientBankCode",
                  "amount",
                  "currency"
                ],
                "properties": {
                  "amount": {
                    "example": 100,
                    "type": "number"
                  },
                  "recipientAccountNumber": {
                    "type": "string",
                    "example": "EXTERNAL12345"
                  },
                  "senderAccountNumber": {
                    "type": "string",
                    "example": "1234567890"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "description": "Permite realizar transferencias a cuentas externas al sistema.",
        "summary": "Transferencia a cuentas de terceros",
        "responses": {
          "404": {
            "description": "Cuenta no encontrada"
          },
          "400": {
            "description": "Fondos insuficientes o solicitud inválida"
          },
          "500": {
            "description": "Error en la transferencia"
          },
          "200": {
            "description": "Transferencia a terceros realizada exitosamente"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/auth/login": {
      "post": {
        "responses": {
          "401": {
            "description": "Credenciales incorrectas"
          },
          "200": {
            "description": "Login exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "description": "JWT token para autenticación",
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        },
        "tags": [
          "Autenticación y Perfil"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "password": {
                    "type": "string",
                    "example": "password123"
                  },
                  "username": {
                    "type": "string",
                    "example": "johndoe"
                  }
                },
                "type": "object",
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "summary": "Iniciar sesión",
        "description": "Permite a un usuario iniciar sesión en el sistema."
      }
    },
    "/bank/account": {
      "post": {
        "description": "Obtiene los detalles de las cuentas del usuario, como saldo en USD y EUR.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Consultar detalles de cuenta del usuario",
        "tags": [
          "Consultas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userID": {
                    "type": "integer",
                    "example": 1
                  }
                },
                "required": [
                  "userID"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos de cuenta obtenidos exitosamente"
          },
          "404": {
            "description": "Usuario no encontrado"
          },
          "500": {
            "description": "Error al obtener los datos de la cuenta"
          },
          "400": {
            "description": "ID de usuario no proporcionado"
          }
        }
      }
    },
    "/otp/send": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "phoneNumber": {
                    "description": "Número de teléfono al que se enviará el OTP",
                    "type": "string",
                    "example": "+51987654321"
                  }
                },
                "required": [
                  "phoneNumber"
                ],
                "type": "object"
              }
            }
          }
        },
        "tags": [
          "OTP"
        ],
        "responses": {
          "400": {
            "description": "Número de teléfono inválido"
          },
          "200": {
            "description": "Código OTP enviado exitosamente"
          },
          "429": {
            "description": "Demasiados intentos, por favor espere antes de solicitar otro OTP"
          }
        },
        "summary": "Enviar código OTP",
        "description": "Envía un código OTP al número de teléfono proporcionado para verificación."
      }
    },
    "/user/profile/{userID}/password": {
      "put": {
        "tags": [
          "Autenticación y Perfil"
        ],
        "responses": {
          "200": {
            "description": "Contraseña actualizada exitosamente"
          },
          "400": {
            "description": "No se pudo actualizar la contraseña"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Permite actualizar únicamente la contraseña del usuario especificado.",
        "parameters": [
          {
            "required": true,
            "name": "userID",
            "schema": {
              "type": "integer",
              "example": 1
            },
            "in": "path",
            "description": "ID del usuario cuya contraseña se actualizará."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "password"
                ],
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "example": "nuevaPassword123"
                  }
                }
              }
            }
          }
        },
        "summary": "Actualizar contraseña de usuario"
      }
    },
    "/user/profile/{userID}": {
      "put": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "lastname": {
                        "type": "string",
                        "example": "Doe"
                      },
                      "firstname": {
                        "type": "string",
                        "example": "John"
                      }
                    }
                  },
                  {
                    "required": [
                      "password"
                    ],
                    "type": "object",
                    "properties": {
                      "password": {
                        "type": "string",
                        "example": "nuevaPassword123"
                      }
                    }
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado exitosamente"
          },
          "400": {
            "description": "No se pudo actualizar el perfil"
          }
        },
        "summary": "Actualizar perfil de usuario",
        "tags": [
          "Autenticación y Perfil"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "name": "userID",
            "in": "path",
            "description": "ID del usuario a actualizar."
          }
        ],
        "description": "Permite actualizar el perfil del usuario especificado. Se puede actualizar información básica o la contraseña."
      },
      "get": {
        "tags": [
          "Autenticación y Perfil"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            },
            "description": "ID del usuario a consultar."
          },
          {
            "name": "paygoat-nivel",
            "in": "header",
            "required": true,
            "description": "Encabezado personalizado para la solicitud",
            "schema": {
              "type": "string",
              "example": "practice"
            }
          }
        ],
        "description": "Devuelve toda la información del perfil de un usuario, incluyendo la contraseña.",
        "summary": "Consultar perfil de usuario",
        "responses": {
          "404": {
            "description": "Usuario no encontrado"
          },
          "200": {
            "description": "Perfil de usuario encontrado"
          }
        }
      }
    },
    "/user/reset-password": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "newPassword": {
                    "description": "Nueva contraseña",
                    "type": "string",
                    "example": "nuevaPassword123"
                  },
                  "otp": {
                    "type": "string",
                    "description": "Código OTP recibido",
                    "example": "123456"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": "Número de teléfono registrado",
                    "example": "+51987654321"
                  }
                },
                "type": "object",
                "required": [
                  "phoneNumber",
                  "otp",
                  "newPassword"
                ]
              }
            }
          }
        },
        "summary": "Restablecer contraseña con OTP",
        "tags": [
          "Autenticación y Perfil"
        ],
        "description": "Permite restablecer la contraseña usando un código OTP enviado al número de teléfono registrado.",
        "responses": {
          "404": {
            "description": "Usuario no encontrado"
          },
          "400": {
            "description": "Código OTP inválido o solicitud incorrecta"
          },
          "200": {
            "description": "Contraseña restablecida exitosamente"
          }
        }
      }
    },
    "/bank/loan/request": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "userID": {
                    "type": "integer",
                    "example": 3
                  },
                  "amount": {
                    "example": 1200,
                    "type": "number"
                  }
                },
                "required": [
                  "userID",
                  "amount"
                ],
                "type": "object"
              }
            }
          }
        },
        "description": "El usuario solicita un préstamo. Solo se permiten 2 préstamos por usuario y el monto mínimo es $1000 USD.",
        "tags": [
          "Créditos"
        ],
        "summary": "Solicitar un préstamo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Préstamo aprobado y depositado"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Préstamo aprobado"
          },
          "403": {
            "description": "Usuario ya tiene el número máximo de préstamos"
          },
          "500": {
            "description": "Error interno del servidor"
          },
          "400": {
            "description": "Datos incompletos o monto no permitido"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Autenticación y Perfil",
      "description": "Endpoints relacionados con autenticación y gestión de perfiles"
    },
    {
      "name": "Transacciones",
      "description": "Endpoints para realizar transacciones financieras"
    },
    {
      "name": "Consultas",
      "description": "Endpoints para consultar información"
    },
    {
      "name": "OTP",
      "description": "Endpoints para manejo de One-Time Password (OTP)"
    },
    {
      "name": "Créditos",
      "description": "Endpoints para gestión de préstamos y créditos"
    }
  ],
  "openapi": "3.0.0",
  "info": {
    "title": "PAYGoat API",
    "description": "API vulnerable a lógica de negocio para el proyecto PAYGoat",
    "version": "1.0.0"
  }
}