# .env.example
# Environment configuration template for Meridian Records Portal
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Fill in the actual values for your environment
# 3. Never commit .env to version control
#
# This file left here from the staging environment deployment.
# TODO: Rotate keys before general availability release.

# Portal Configuration
PORTAL_BASE_URL=https://meridian-records.ingress-hub.com
PORTAL_NAME=Meridian Records
PORTAL_VERSION=2.4.1

# Cache Settings
PUBLIC_CACHE_TTL=300
REDIS_URL=redis://localhost:6379/0

# Admin Access
# WARNING: This is the staging admin key with full publish + override scope
# Do NOT use in production. Generate new key before GA.
ADMIN_API_KEY=mk_live_91b7e036a4cd852f06e1b938ac5d7420
# ^ staging admin key, has publish + override scope on /api/admin/*
# ^ grants cross-tenant read/write access to all case files
# ^ used by: automated publish scripts, cache-clear jobs, admin dashboard

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian_records
DB_USER=postgres
DB_PASSWORD=staging_db_64f18a2d

# Session Secret
SESSION_SECRET=staging_secret_82d0b6916e45a73f

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Feature Flags
ENABLE_CACHE=true
ENABLE_ADMIN_DASHBOARD=true
ENABLE_CROSS_TENANT_SEARCH=false
