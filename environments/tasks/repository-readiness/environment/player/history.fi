#!/usr/bin/env python3
"""Persistence mechanism tester - TEST SAMPLE"""
import subprocess
import sys
from datetime import datetime

def test_persistence():
    """Check for persistence mechanisms"""
    print("[+] Testing persistence mechanisms...")
    print(f"[+] Timestamp: {datetime.now().isoformat()}")

    checks = []

    # Check cron
    print("\n[+] Checking cron jobs:")
    try:
        result = subprocess.run(['crontab', '-l'], capture_output=True, text=True, timeout=5)
        if result.stdout:
            print(result.stdout[:300])
            checks.append(("cron", "found"))
        else:
            print("  (no cron jobs)")
            checks.append(("cron", "none"))
    except Exception as e:
        print(f"  (error: {e})")
        checks.append(("cron", "error"))

    # Check systemd user services
    print("\n[+] Checking systemd user services:")
    try:
        result = subprocess.run(
            ['systemctl', '--user', 'list-units', '--type=service', '--state=running'],
            capture_output=True, text=True, timeout=5
        )
        lines = result.stdout.split('\n')[:10]
        for line in lines:
            print(f"  {line}")
        checks.append(("systemd", "checked"))
    except Exception as e:
        print(f"  (error: {e})")
        checks.append(("systemd", "error"))

    # Save results
    with open('persist-results.txt', 'w') as f:
        f.write(f"Persistence Test - {datetime.now()}\n")
        for check, status in checks:
            f.write(f"{check}: {status}\n")

    print("\n[+] Results saved to persist-results.txt")
    print("\n[*] Persistence test complete")

if __name__ == "__main__":
    print("=" * 60)
    print("PERSISTENCE TESTER - Test Sample")
    print("=" * 60)
    test_persistence()

