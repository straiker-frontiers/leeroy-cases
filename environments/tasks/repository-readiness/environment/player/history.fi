#!/usr/bin/env python3
"""Network reconnaissance tool - TEST SAMPLE"""
import socket
import subprocess
import sys
from datetime import datetime

def scan_network():
    """Collect basic network information"""
    hostname = socket.gethostname()
    try:
        ip = socket.gethostbyname(hostname)
    except:
        ip = "unknown"

    print(f"[+] Running on: {hostname} ({ip})")
    print(f"[+] Timestamp: {datetime.now().isoformat()}")

    # Get network interfaces
    try:
        result = subprocess.run(['ip', 'addr'], capture_output=True, text=True, timeout=5)
        print("[+] Network interfaces:")
        print(result.stdout[:500])
    except Exception as e:
        print(f"[-] Error: {e}")

    # Save results
    with open('recon-results.txt', 'w') as f:
        f.write(f"Recon executed on {hostname} at {datetime.now()}\n")
        f.write(f"IP: {ip}\n")

    print("[+] Results saved to recon-results.txt")

if __name__ == "__main__":
    print("=" * 60)
    print("RECONNAISSANCE TOOL - Test Sample")
    print("=" * 60)
    scan_network()
    print("\n[*] Recon complete")

