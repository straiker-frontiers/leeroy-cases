#!/usr/bin/env python3
"""Data exfiltration simulator - TEST SAMPLE"""
import os
import sys
from datetime import datetime

def collect_data():
    """Simulate collecting system information"""
    print("[+] Collecting system information...")

    data = {
        'hostname': os.uname().nodename,
        'user': os.getenv('USER', 'unknown'),
        'timestamp': datetime.now().isoformat(),
        'home': os.path.expanduser('~'),
        'cwd': os.getcwd()
    }

    print(f"[+] Target: {data['hostname']}")
    print(f"[+] User: {data['user']}")
    print(f"[+] Working directory: {data['cwd']}")

    # Simulate writing exfil data
    output_file = f"exfil-{data['hostname']}-{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
    with open(output_file, 'w') as f:
        f.write(f"Exfiltration Test Results\n")
        f.write(f"{'=' * 40}\n")
        for key, value in data.items():
            f.write(f"{key}: {value}\n")

    print(f"[+] Data written to: {output_file}")
    return output_file

if __name__ == "__main__":
    print("=" * 60)
    print("EXFILTRATION SIMULATOR - Test Sample")
    print("=" * 60)
    result = collect_data()
    print(f"\n[*] Test complete. Output: {result}")

